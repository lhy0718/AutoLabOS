# Optional: AutoLabOS setup can write this for you on first run.
SEMANTIC_SCHOLAR_API_KEY=
# Recommended: OpenAlex applies strict limits to unauthenticated requests.
OPENALEX_API_KEY=
# Required if the primary provider is OpenAI API or PDF analysis mode is set to Responses API.
# Governed Docker runs convert this value to a temporary private secret file;
# the repository .env file is never mounted into the experiment container.
OPENAI_API_KEY=
# Optional: image used for per-envelope Docker containers. The image must
# contain the experiment dependencies, /usr/bin/env, and /bin/sh.
AUTOLABOS_DOCKER_IMAGE=
# Optional alternative to OPENAI_API_KEY: path to a credential-only private
# env file mounted read-only at /run/secrets/autolabos.env.
AUTOLABOS_DOCKER_SECRET_FILE=
